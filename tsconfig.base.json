{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@simultaneous-transcription-ae/source"],
    "paths": {
      "@simultaneous-transcription-ae/shared-types": [
        "./libs/shared-types/src/index.ts"
      ],
      "@simultaneous-transcription-ae/api": ["./apps/api/src"],
      "@simultaneous-transcription-ae/api/*": ["./apps/api/src/*"]
    }
  }
}
